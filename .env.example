# Copy to .env and fill in what you have. Everything is optional.
# Groq key enables LLM generation with gpt-oss-20b (free tier: https://console.groq.com/keys).
# Without it the app uses an offline extractive summariser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# NCBI key raises the PubMed rate limit from 3 to 10 requests/s (https://www.ncbi.nlm.nih.gov/account/)
NCBI_API_KEY=
NCBI_EMAIL=

# auto = fine-tuned BioBERT grader if trained, else MedCPT
GRADER=auto
